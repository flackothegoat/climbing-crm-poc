{$APP_DOMAIN} {
  encode zstd gzip

  @nextStatic path /_next/static/*
  header @nextStatic >Cache-Control "public, max-age=31536000, immutable"

  @wallAssets path /walls/*
  header @wallAssets >Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

  handle_path /wvp-media/* {
    reverse_proxy media:80 {
      flush_interval -1
    }
  }

  handle_path /wvp/* {
    reverse_proxy wvp-ui:8080
  }

  # The WVP UI is hosted below /wvp, but its compiled client calls an absolute
  # /api path. Keep that namespace dedicated to the WVP backend; the CRM API is
  # intentionally exposed through /backend below.
  @wvpApi path /api/*
  handle @wvpApi {
    reverse_proxy wvp:18978
  }

  @backend path /backend/*
  handle @backend {
    header >Cache-Control "private, no-store"
    uri replace /backend /api
    reverse_proxy api:3101
  }

  handle {
    reverse_proxy web:3100
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

model HoldInstallation {
  id                   String                   @id @default(cuid())
  organizationId       String
  installRequestKey    String
  removeRequestKey     String?
  holdVariantId        String
  routeVersionId       String?
  routeHoldPlacementId String?
  settingJobId         String?
  observedHoldId       String?                  @unique
  status               HoldInstallationStatus   @default(INSTALLED)
  source               HoldInstallationSource
  installedAt          DateTime
  removedAt            DateTime?
  installedByAccountId String?
  removedByAccountId   String?
  note                 String?
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  holdVariant          HoldVariant              @relation(fields: [holdVariantId], references: [id], onDelete: Restrict)
  routeVersion         RouteVersion?            @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  routeHoldPlacement   RouteHoldPlacement?      @relation(fields: [routeHoldPlacementId], references: [id], onDelete: Restrict)

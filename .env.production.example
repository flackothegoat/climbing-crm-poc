# Public address. Azure Public IP DNS labels use this form.
APP_DOMAIN=replace-with-dns-label.southeastasia.cloudapp.azure.com

# Database. Generate a long random password before deployment.
POSTGRES_USER=climbing_poc
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=climbing_poc

# Object storage. Generate independent credentials before deployment.
MINIO_ROOT_USER=climbing-poc-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
MINIO_BUCKET=climbingapp-hold-assets

SESSION_COOKIE_NAME=climbing_crm_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=168
INVITATION_TTL_HOURS=72

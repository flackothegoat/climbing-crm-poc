# Docker local dependencies. These ports avoid colliding with the legacy ClimbingApp stack.
POC_POSTGRES_PORT=5434
POC_REDIS_PORT=6380
POC_MINIO_API_PORT=9002
POC_MINIO_CONSOLE_PORT=9003
POSTGRES_USER=climbing_poc
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=climbing_poc
DATABASE_URL=postgresql://climbing_poc:replace-with-a-local-password@localhost:5434/climbing_poc?schema=public
MINIO_ROOT_USER=climbing-poc-local
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_BUCKET=climbingapp-hold-assets
API_PORT=3101
SESSION_COOKIE_NAME=climbing_crm_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
INVITATION_TTL_HOURS=72
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101/api
WEB_ORIGIN=http://localhost:3100
# Set false only when intentionally pausing the local background GLB cleaner.
HOLD_MODEL_PROCESSING_ENABLED=true

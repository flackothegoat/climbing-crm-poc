model WallGeometryVersion {
  id                       String                    @id @default(cuid())
  organizationId           String
  wallSegmentId            String
  versionNumber            Int
  status                   WallGeometryVersionStatus @default(DRAFT)
  calibration              WallCalibrationStatus     @default(SURVEY_ESTIMATE)
  widthMm                  Int
  heightMm                 Int
  surfaceHeightMm          Int?
  angleFromVerticalDegrees Float?
  horizontalPitchMm        Int?
  verticalPitchMm          Int?
  coordinateSystem         Json?
  note                     String?

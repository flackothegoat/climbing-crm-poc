  removedBy            Account?                 @relation("HoldInstallationRemover", fields: [removedByAccountId], references: [id], onDelete: Restrict)
  anchors              HoldInstallationAnchor[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([organizationId, installRequestKey])
  @@unique([organizationId, removeRequestKey])
  @@index([organizationId, status, installedAt])
  @@index([holdVariantId, status])
  @@index([routeVersionId])
  @@index([routeHoldPlacementId])
  @@index([settingJobId])
}

model HoldInstallationAnchor {

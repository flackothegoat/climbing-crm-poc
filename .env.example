# Docker local dependencies. These ports avoid colliding with the legacy ClimbingApp stack.
POC_POSTGRES_PORT=5434
POC_REDIS_PORT=6380
POC_MINIO_API_PORT=9002
POC_MINIO_CONSOLE_PORT=9003
POSTGRES_USER=climbing_poc
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=climbing_poc
DATABASE_URL=postgresql://climbing_poc:replace-with-a-local-password@localhost:5434/climbing_poc?schema=public
MINIO_ROOT_USER=climbing-poc-local
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_BUCKET=climbingapp-hold-assets
API_PORT=3101
SESSION_COOKIE_NAME=climbing_crm_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
INVITATION_TTL_HOURS=72
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101/api
WEB_ORIGIN=http://localhost:3100
# Set false only when intentionally pausing the local background GLB cleaner.
HOLD_MODEL_PROCESSING_ENABLED=true
# Single-camera POC. Override these values when the GB28181 channel changes.
CAMERA_LIVE_ENABLED=true
CAMERA_LIVE_NAME=攀岩墙主摄像头
CAMERA_PLAYER_URL='https://galsync-climbing-demo-01.southeastasia.cloudapp.azure.com/wvp/#/play/share?type=2&url=wss%3A%2F%2Fgalsync-climbing-demo-01.southeastasia.cloudapp.azure.com%2Fwvp-media%2Frtp%2F34020000001320000001_34020000001320000001.live.flv%3ForiginTypeStr%3Drtp_push%26videoCodec%3DH264'
CAMERA_RESOURCE_URL=wss://galsync-climbing-demo-01.southeastasia.cloudapp.azure.com/wvp-media/rtp/34020000001320000001_34020000001320000001.live.flv?originTypeStr=rtp_push&videoCodec=H264
CAMERA_PROBE_URL=https://galsync-climbing-demo-01.southeastasia.cloudapp.azure.com/wvp-media/rtp/34020000001320000001_34020000001320000001.live.flv?originTypeStr=rtp_push&videoCodec=H264
CAMERA_PROBE_TIMEOUT_MS=4000
CAMERA_PROBE_CACHE_MS=10000
CAMERA_SNAPSHOT_TIMEOUT_MS=20000
CAMERA_SNAPSHOT_CACHE_MS=5000
CAMERA_SNAPSHOT_STALE_MS=300000
# Browser-side lightweight SAM. The first use downloads and caches the model.
NEXT_PUBLIC_SAM_MODEL_ID=Xenova/slimsam-77-uniform
